# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=sqlite:///./FofoLocalTv.db

# API Security
# Change this to a strong random string in production
SECRET_API_KEY=50474c4f4d414e49544f434f4d4f5345524941

# Server Configuration (optional)
# HOST=0.0.0.0
# PORT=8000
# DEBUG=True

# Seguridad de red:
# La app enlaza a 0.0.0.0 para que el Chromecast/dispositivos de la LAN alcancen
# el proxy HLS. Por eso, los endpoints peligrosos (auto-updater y administración)
# solo aceptan peticiones DEL PROPIO EQUIPO (loopback). El proxy de segmentos
# valida que el destino sea un host público (no se puede usar como relay SSRF
# contra tu red interna). El auto-updater solo descarga releases oficiales de
# GitHub por HTTPS.
#
# Si de verdad necesitas administrar desde otro dispositivo de la LAN, habilítalo
# y CAMBIA la API key por una aleatoria (la default es pública):
# LOCALTV_ALLOW_LAN_ADMIN=true
#
# Para no exponer nada a la red (solo este equipo, sin casting):
# LOCALTV_BIND=127.0.0.1

# Xtream (Magma / cualquier panel IPTV). Pon TUS propias credenciales.
# Sin estas variables, el catálogo Magma se importa pero queda inactivo
# (oculto en la app pública) hasta que las configures.
# Host con esquema y sin barra final, p.ej. http://tu-panel.com:8080
# XTREAM_HOST=
# XTREAM_USERNAME=
# XTREAM_PASSWORD=
# XTREAM_OUTPUT=ts
